# ==============================================================================
# BugPilot Backend Configuration
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ==============================================================================
# AI Architecture & Provider Configuration (Provider-Agnostic)
# ==============================================================================

# Global Provider Selection
# Options: gemini | groq | openrouter | ollama | openai | anthropic | mock
# If unset, individual task configurations determine the preferred provider
AI_PROVIDER=gemini
PRIMARY_AI_PROVIDER=gemini

# Fallback Provider Chain (Comma-separated priority list)
# Example: groq,openrouter,ollama,mock
FALLBACK_AI_PROVIDERS=groq,openrouter,ollama,mock

# Provider API Keys (Server-side only — never exposed to client)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# Local Ollama Configuration (No API key required for local development)
OLLAMA_BASE_URL=http://localhost:11434

# Observability & Logging Level
AI_LOG_LEVEL=info

# Platform (web app) URL — used for invite email redirects.
# Invites redirect to ${PLATFORM_URL}/accept-invite (and "Forgot password" to the same page):
# that exact URL MUST be in Supabase → Authentication → URL Configuration → Redirect URLs.
# See docs/mobile-qa/AUTH_SETUP.md for the required hosted-Supabase settings.
PLATFORM_URL=http://localhost:3000

# Supabase anon (public) key — used ONLY by /api/auth/login and /api/auth/refresh.
# Never put the service-role key here.
SUPABASE_ANON_KEY=your-supabase-anon-key

# Trust X-Forwarded-For from a reverse proxy so rate limiting keys on the real client IP.
# MUST be set when running behind a proxy/load balancer; otherwise every client shares the
# proxy's IP and the login/refresh rate limits become one global bucket.
# Safe choices: a hop count equal to the real number of proxies (e.g. 1), or a subnet list
# (e.g. loopback,10.0.0.0/8). `true` is treated as 1 hop (a warning is logged), because
# trusting the left-most X-Forwarded-For entry lets clients forge their IP.
# Leave unset when not behind a proxy.
TRUST_PROXY=

# Comma-separated Supabase user ids allowed to call POST /api/issues/retention/cleanup
# (a global, cross-tenant cleanup). Unset/empty = nobody may call it (403).
RETENTION_ADMIN_USER_IDS=
